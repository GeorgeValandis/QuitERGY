default_platform(:ios)

platform :ios do
  desc "Upload only App Store screenshots (no build, no metadata)"
  lane :upload_screenshots do |options|
    screenshots_path = options[:screenshots_path] || ENV["SCREENSHOTS_PATH"] || "./fastlane/screenshots"
    overwrite = options.key?(:overwrite) ? options[:overwrite] : (ENV["OVERWRITE_SCREENSHOTS"] == "true")
    image_files = Dir.glob(File.join(screenshots_path, "**", "*.{png,jpg,jpeg}"), File::FNM_CASEFOLD)

    if image_files.empty?
      UI.user_error!("No screenshot image files found in '#{screenshots_path}'. Aborting to avoid deleting existing App Store screenshots.")
    end

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      duration: 1200
    )

    deliver(
      api_key: api_key,
      app_identifier: ENV["APP_IDENTIFIER"] || "com.GA.QuitERGY",
      platform: "ios",
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      overwrite_screenshots: overwrite,
      screenshots_path: screenshots_path,
      run_precheck_before_submit: false
    )
  end

  desc "Submit the prepared App Store version for review"
  lane :submit_for_review do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"],
      duration: 1200
    )

    deliver(
      api_key: api_key,
      app_identifier: ENV["APP_IDENTIFIER"] || "com.GA.QuitERGY",
      platform: "ios",
      app_version: options[:app_version] || ENV["APP_VERSION"] || "1.0.7",
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      skip_app_version_update: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
